<Page x:Class="_090207_P_123_Op_Payment.Pages.AddCategoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_090207_P_123_Op_Payment.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Добавление категорий платежа">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Название категории" Grid.Row="0" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="55,0,0,0"/>
        <TextBox x:Name="TBCategoryName" Grid.Row="0" Height="35" Width="300" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="400,0,0,0" FontSize="16" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="ButtonClean" Content="Очистить" Width="120" Height="40" Click="ButtonClean_Click" Margin="0,0,20,0"/>
            <Button x:Name="ButtonSaveCategory" Content="Сохранить" Width="120" Height="40" Click="ButtonSaveCategory_Click"/>
        </StackPanel>
    </Grid>
</Page>
