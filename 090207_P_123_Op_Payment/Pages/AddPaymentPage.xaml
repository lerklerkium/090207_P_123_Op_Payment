<Page x:Class="_090207_P_123_Op_Payment.Pages.AddPaymentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_090207_P_123_Op_Payment.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Добавление платежа">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Название платежа" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="18" Margin="10,0,0,0"/>
        <TextBox x:Name="TBPaymentName" Grid.Row="0" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="10,5,50,5" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Сумма" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="18" Margin="10,0,0,0"/>
        <TextBox x:Name="TBAmount" Grid.Row="1" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="10,5,50,5" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Количество" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontSize="18" Margin="10,0,0,0"/>
        <TextBox x:Name="TBCount" Grid.Row="2" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="10,5,50,5" Text="{Binding Num, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Дата" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontSize="18" Margin="10,0,0,0"/>
        <TextBox x:Name="TBDate" Grid.Row="3" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="10,5,50,5" Text="{Binding Date, StringFormat=\{0:dd.MM.yyyy\}, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Клиент (Пользователь)" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontSize="18" Margin="10,0,0,0"/>
        <ComboBox x:Name="CBUser" Grid.Row="4" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="10,5,50,5" SelectedValuePath="ID" SelectedValue="{Binding UserID, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Категория платежа" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" FontSize="18" Margin="10,0,0,0"/>
        <ComboBox x:Name="CBCategory" Grid.Row="5" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="10,5,50,5" SelectedValuePath="ID" SelectedValue="{Binding CategoryID, UpdateSourceTrigger=PropertyChanged}"/>

        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,50,0">
            <Button x:Name="ButtonClean" Content="Очистить" Width="100" Height="35" Click="ButtonClean_Click" Margin="0,0,10,0"/>
            <Button x:Name="ButtonSave" Content="Сохранить" Width="100" Height="35" Click="ButtonSave_Click"/>
        </StackPanel>
    </Grid>
</Page>
