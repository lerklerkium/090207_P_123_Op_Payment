<Page x:Class="_090207_P_123_Op_Payment.Pages.AddUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_090207_P_123_Op_Payment.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Добавление нового пользователя">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Логин" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="20" Margin="10,0,0,0" />
        <TextBlock Text="Пароль" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="20" Margin="10,0,0,0" />
        <TextBlock Text="Роль" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontSize="20" Margin="10,0,0,0" />
        <TextBlock Text="ФИО" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontSize="20" Margin="10,0,0,0" />
        <TextBlock Text="Фото (необязательно)" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontSize="20" Margin="10,0,0,0" />

        <TextBox x:Name="TBLogin" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="10,5,50,5" ToolTip="Введите логин" />
        <TextBox x:Name="TBPass" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="10,5,50,5" ToolTip="Введите пароль" />

        <ComboBox x:Name="cmbRole" SelectedValuePath="Content" SelectedValue="{Binding Role, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="10,5,50,5" ToolTip="Выберите роль">
            <ComboBoxItem Content="Admin" />
            <ComboBoxItem Content="User" />
            <ComboBoxItem Content="Администратор" />
            <ComboBoxItem Content="Пользователь" />
        </ComboBox>

        <TextBox x:Name="TBFio" Text="{Binding FIO, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="10,5,50,5" ToolTip="Введите ФИО" />
        <TextBox x:Name="TBPhoto" Text="{Binding Photo, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="10,5,50,5" ToolTip="Добавьте фото" />

        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,50,0">
            <Button x:Name="ButtonClean" Content="Очистить" Width="100" Height="35" Click="ButtonClean_Click" Margin="0,0,10,0" />
            <Button x:Name="ButtonSave" Content="Сохранить" Width="100" Height="35" Click="ButtonSave_Click" />
        </StackPanel>
    </Grid>
</Page>
