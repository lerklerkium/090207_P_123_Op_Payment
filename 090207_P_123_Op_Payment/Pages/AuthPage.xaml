<Page x:Class="_090207_P_123_Op_Payment.Pages.AuthPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_090207_P_123_Op_Payment.Pages"
        mc:Ignorable="d"
        Title="Авторизация в системе" Height="450" Width="800">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="800" Height="450">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- ТЕКСТОВЫЕ МЕТКИ (ДОБАВЛЕНЫ ИМЕНА x:Name ДЛЯ ХОРОШЕЙ РАБОТЫ В C#) -->
        <StackPanel Grid.Column="0" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,20,10">
            <Label x:Name="labelLogin" Content="Логин:" FontSize="16" Height="34"/>
            <Label x:Name="labelPass" Content="Пароль:" FontSize="16" Height="34" Margin="0,15,0,0"/>

            <!-- Метка капчи (Изначально скрыта, x:Name исправлен) -->
            <Label x:Name="labelCaptcha" Content="Капча:" FontSize="16" Height="34" Visibility="Hidden" Margin="0,15,0,0"/>
        </StackPanel>

        <!-- ПОЛЯ ВВОДА И ТЕКСТОВЫЕ ПОДСКАЗКИ -->
        <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,0,0,10">
            <!-- Элементы логина -->
            <Grid>
                <TextBox x:Name="TextBoxLogin" Width="200" Height="34" FontSize="14" ToolTip="Введите логин или почту" TextChanged="TextBoxLogin_TextChanged"/>
                <TextBlock x:Name="txtHintLogin" Text="Введите логин" IsHitTestVisible="False" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Gray" Visibility="Collapsed"/>
            </Grid>

            <!-- Элементы пароля -->
            <Grid Margin="0,15,0,0">
                <PasswordBox x:Name="PasswordBox" Width="200" Height="34" FontSize="14" ToolTip="Введите пароль" PasswordChanged="PasswordBox_PasswordChanged"/>
                <TextBlock x:Name="txtHintPass" Text="Введите пароль" IsHitTestVisible="False" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Gray" Visibility="Collapsed"/>
            </Grid>

            <!-- Текст капчи (Запрещено копирование, Изначально скрыт) -->
            <TextBox x:Name="captcha" 
                 Grid.Column="1"
                 CommandManager.PreviewExecuted="textBox_PreviewExecuted"
                 ContextMenu="{x:Null}"
                 Visibility="Hidden"
                 Height="42"
                 Width="200"
                 Foreground="Red"
                 FontStyle="Italic"
                 FontWeight="Heavy"
                 Background="{x:Null}"
                 FontStretch="UltraCondensed"
                 IsReadOnly="True"
                 HorizontalContentAlignment="Center"
                 VerticalContentAlignment="Center"
                 FontSize="20"
                 Margin="0,15,0,0"/>

            <!-- Поле для ввода капчи пользователем (Изначально скрыто) -->
            <TextBox x:Name="captchaInput" 
                 Grid.Column="1"
                 Visibility="Hidden"
                 Height="34"
                 Width="200"
                 TextWrapping="Wrap"
                 Text=""
                 Margin="0,15,0,0"/>
        </StackPanel>

        <!-- КНОПКИ (НИЖНЯЯ СТРОКА GRID.ROW="1") -->
        <StackPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,10,0,0">
            <!-- Стандартные кнопки управления -->
            <Button x:Name="ButtonEnter" Content="Вход" Width="150" Height="35" ToolTip="Кнопка входа" Click="ButtonEnter_OnClick"/>
            <Button x:Name="ButtonReg" Content="Регистрация" Width="150" Height="35" Margin="0,10,0,0" ToolTip="Кнопка регистрации" Click="ButtonReg_Click"/>
            <Button x:Name="ButtonChangePassword" Content="Смена пароля" Width="150" Height="35" Margin="0,10,0,0" ToolTip="Кнопка смены пароля" Click="ButtonChangePassword_Click"/>

            <!-- Кнопка подтверждения капчи (Изначально скрыта) -->
            <Button x:Name="submitCaptcha" 
                Content="Подтвердить" 
                Width="150" 
                Height="35" 
                Visibility="Hidden" 
                ToolTip="Подтвердить ввод капчи" 
                Click="submitCaptcha_Click"/>
        </StackPanel>
    </Grid>
</Page>
