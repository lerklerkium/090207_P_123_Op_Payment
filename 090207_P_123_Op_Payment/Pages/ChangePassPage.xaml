<Page x:Class="_090207_P_123_Op_Payment.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_090207_P_123_Op_Payment.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Смена текущего пароля">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="800" Height="450">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- Левый столбец (Grid.Column="0"): Текстовые метки полей -->
        <StackPanel Grid.Column="0" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,20,10">
            <Label Content="Логин:" FontSize="16" Height="34"/>
            <Label Content="Текущий пароль:" FontSize="16" Height="34" Margin="0,15,0,0"/>
            <Label Content="Новый пароль:" FontSize="16" Height="34" Margin="0,15,0,0"/>
            <Label Content="Повторите пароль:" FontSize="16" Height="34" Margin="0,15,0,0"/>
        </StackPanel>

        <!-- Правый столбец (Grid.Column="1"): Поля ввода и скрывающиеся подсказки -->
        <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,0,0,10">
            <!-- Логин -->
            <Grid>
                <TextBox x:Name="TbLogin" Width="200" Height="34" FontSize="14" ToolTip="Введите ваш логин" TextChanged="TbLogin_TextChanged"/>
                <Label x:Name="lblLogHint" Content="Введите логин" Foreground="Gray" VerticalAlignment="Center" Margin="5,0,0,0" IsHitTestVisible="False"/>
            </Grid>

            <!-- Текущий пароль -->
            <Grid Margin="0,15,0,0">
                <PasswordBox x:Name="CurrentPasswordBox" Width="200" Height="34" FontSize="14" ToolTip="Введите текущий пароль" PasswordChanged="CurrentPasswordBox_PasswordChanged"/>
                <Label x:Name="lblCurrentPassHint" Content="Введите текущий пароль" Foreground="Gray" VerticalAlignment="Center" Margin="5,0,0,0" IsHitTestVisible="False"/>
            </Grid>

            <!-- Новый пароль -->
            <Grid Margin="0,15,0,0">
                <PasswordBox x:Name="NewPasswordBox" Width="200" Height="34" FontSize="14" ToolTip="Придумайте новый пароль" PasswordChanged="NewPasswordBox_PasswordChanged"/>
                <Label x:Name="lblNewPassHint" Content="Придумайте новый пароль" Foreground="Gray" VerticalAlignment="Center" Margin="5,0,0,0" IsHitTestVisible="False"/>
            </Grid>

            <!-- Повтор нового пароля -->
            <Grid Margin="0,15,0,0">
                <PasswordBox x:Name="ConfirmPasswordBox" Width="200" Height="34" FontSize="14" ToolTip="Повторите новый пароль" PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                <Label x:Name="lblConfirmPassHint" Content="Повторите новый пароль" Foreground="Gray" VerticalAlignment="Center" Margin="5,0,0,0" IsHitTestVisible="False"/>
            </Grid>
        </StackPanel>

        <!-- Нижняя строка (Grid.Row="1"): Кнопка сохранения изменений -->
        <StackPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,10,0,0">
            <Button x:Name="ButtonSavePassword" Content="Сохранить изменения" Width="180" Height="35" ToolTip="Нажмите для сохранения нового пароля" Click="ButtonSavePassword_Click"/>
        </StackPanel>
    </Grid>
</Page>
